{
  "name": "ai-office-dashboard",
  "version": "0.1.2",
  "private": true,
  "description": "A privacy-conscious, real-time office dashboard for Codex projects and AI workers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/byStander9/my-ai-office.git"
  },
  "keywords": [
    "codex",
    "multi-agent",
    "dashboard",
    "observability"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "office": "npm run build && node server/office-server.mjs",
    "start:office": "node server/office-server.mjs",
    "preview": "vite preview",
    "test": "npm run test:office && npm run test:sites",
    "test:office": "node --test tests/event-reducer.test.mjs tests/event-sink.test.mjs tests/hook-config.test.mjs tests/office-server.test.mjs tests/project-order.test.mjs",
    "test:sites": "npm run build && node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  }
}
